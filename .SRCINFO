	makedepends = qt6-tools
	makedepends = rust
	depends = gcc-libs
	depends = glibc
	depends = kirigami
	depends = qt6-base
	depends = qt6-declarative
	depends = xdg-desktop-portal
	depends = xdg-desktop-portal-kde
	options = !lto

pkgname = klickmeister
